# Common build settings
build --incompatible_enable_cc_toolchain_resolution
build --enable_platform_specific_config

# Go settings
build --@io_bazel_rules_go//go/config:static

# Enable verbose failures
build --verbose_failures

# Use modern C++ toolchain
build --cxxopt=-std=c++17

# Platform-specific settings
build:linux --copt=-fPIC
build:linux --linkopt=-fPIC

# MacOS settings
build:macos --copt=-fPIC
build:macos --linkopt=-fPIC

# Test output
test --test_output=errors
test --test_summary=detailed

# Performance
build --jobs=auto

# Convenience aliases
build:release --compilation_mode=opt
build:debug --compilation_mode=dbg

# Nix-specific settings (when building in Nix environment)
build:nix --action_env=PATH
build:nix --action_env=LD_LIBRARY_PATH
build:nix --action_env=PKG_CONFIG_PATH

# Try loading a user-specific .bazelrc file if it exists
try-import %workspace%/.bazelrc.user
