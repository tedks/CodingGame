load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ui",
    srcs = [
        "components.go",
        "menu.go",
        "prompt.go",
        "scene.go",
        "startscreen.go",
    ],
    importpath = "github.com/tedks/CodingGame/internal/ui",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/harness",
        "//internal/input",
        "@com_github_hajimehoshi_ebiten_v2//:ebiten",
        "@com_github_hajimehoshi_ebiten_v2//ebitenutil",
        "@com_github_hajimehoshi_ebiten_v2//vector",
    ],
)

go_test(
    name = "ui_test",
    srcs = [
        "menu_test.go",
        "prompt_test.go",
        "scene_test.go",
        "startscreen_test.go",
    ],
    embed = [":ui"],
    deps = [
        "@com_github_hajimehoshi_ebiten_v2//:ebiten",
    ],
)
