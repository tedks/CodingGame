load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "game",
    srcs = [
        "app.go",
        "game.go",
        "scene.go",
    ],
    importpath = "github.com/tedks/CodingGame/internal/game",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/advisor",
        "//internal/capability",
        "//internal/claude",
        "//internal/dependency",
        "//internal/harness",
        "//internal/harness/claude",
        "//internal/input",
        "//internal/mapview",
        "//internal/multiagent",
        "//internal/production",
        "//internal/resources",
        "//internal/ui",
        "@com_github_hajimehoshi_ebiten_v2//:ebiten",
        "@com_github_hajimehoshi_ebiten_v2//ebitenutil",
    ],
)

go_test(
    name = "game_test",
    srcs = [
        "game_test.go",
        "integration_test.go",
    ],
    embed = [":game"],
    deps = [
        "//internal/testutil",
    ],
)
