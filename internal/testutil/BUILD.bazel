load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "testutil",
    srcs = [
        "compare.go",
        "input.go",
        "race_disabled.go",
        "race_enabled.go",
        "runner.go",
        "scenario.go",
        "screenshot.go",
    ],
    importpath = "github.com/tedks/CodingGame/internal/testutil",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/input",
        "@com_github_hajimehoshi_ebiten_v2//:ebiten",
    ],
)

go_test(
    name = "testutil_test",
    srcs = [
        "compare_test.go",
        "input_test.go",
        "race_test.go",
        "runner_test.go",
        "scenario_test.go",
        "screenshot_test.go",
    ],
    embed = [":testutil"],
    deps = [
        "@com_github_hajimehoshi_ebiten_v2//:ebiten",
    ],
)

# Separate test target for race detection verification.
# This test FAILS if race detection is not enabled, so it must be
# excluded from regular test runs and only run with --@io_bazel_rules_go//go/config:race.
# Use tag "race_only" to exclude from `bazel test //...` via --test_tag_filters=-race_only
go_test(
    name = "race_verification_test",
    srcs = ["race_verification_test.go"],
    embed = [":testutil"],
    tags = ["race_only"],
)
