# Automatically enter Nix development shell when entering this directory
# Requires: direnv (https://direnv.net/)
#
# Installation:
#   1. Install direnv: https://direnv.net/docs/installation.html
#   2. Run: direnv allow
#
# This will automatically load the Nix flake development environment

if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi

use flake

# Export additional environment variables if needed
export BAZEL_USE_CPP_ONLY_TOOLCHAIN=1
export CGO_ENABLED=1

# Print helpful message
echo "🎮 CodingGame Nix environment loaded"
echo "Run 'bazel build //...' to build all targets"
